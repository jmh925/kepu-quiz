/* ============================================================
   首页 —— 去闯关
   只补充本页专有类，全局类（.card/.btn/.pill/.input…）直接复用。
   颜色一律走 app.wxss 的 CSS 变量。
   ============================================================ */

/* ---------- 顶部问候 ---------- */
.greet-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #EAF7FE;
  border-radius: var(--r-card);
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
}

.greet-left {
  flex: 1;
  padding-right: 20rpx;
}

.greet-line {
  margin-top: 8rpx;
  color: var(--c-primary-deep);
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.5;
}

/* ---------- 出题中 ---------- */
.asking-card {
  padding: 40rpx 28rpx 32rpx;
  text-align: center;
}

.fact-box {
  margin-top: 32rpx;
  text-align: left;
  background: #FFF9E8;
  border-radius: 20rpx;
  padding: 24rpx;
}

.fact-head {
  margin-bottom: 10rpx;
}

.fact-emoji {
  font-size: 34rpx;
  margin-right: 10rpx;
}

.fact-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #9A6B00;
}

.fact-text {
  font-size: 32rpx;
  line-height: 1.7;
  color: var(--c-text);
  min-height: 110rpx;
}

.fact-index {
  margin-top: 8rpx;
  text-align: right;
}

.ask-hint {
  margin: 24rpx 0 20rpx;
}

.ask-cancel {
  width: 100%;
}

/* ---------- 学段选择 ---------- */
.grade-list {
  display: flex;
  justify-content: space-between;
}

.grade-btn {
  flex: 1;
  min-height: 128rpx;
  margin-right: 16rpx;
  padding: 18rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #F1F7FC;
  border: 3rpx solid var(--c-line);
  border-radius: 22rpx;
  box-sizing: border-box;
}

.grade-btn:last-child {
  margin-right: 0;
}

.grade-emoji {
  font-size: 40rpx;
  line-height: 1.2;
}

.grade-name {
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--c-sub);
  text-align: center;
}

/* 当前学段高亮 */
.grade-on {
  background: #E3F5FF;
  border-color: var(--c-primary);
}

.grade-on .grade-name {
  color: var(--c-primary-deep);
  font-weight: 700;
}

.grade-tip {
  margin-top: 18rpx;
}

/* ---------- 主题输入 ---------- */
.doc-card {
  background: #F2FBFF;
  border: 3rpx solid var(--c-primary);
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 22rpx;
}

.doc-emoji {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.doc-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--c-primary-deep);
  line-height: 1.5;
}

.input-ph {
  color: var(--c-sub);
  font-size: 32rpx;
}

/* 主题快捷入口 */
.chip-wrap {
  margin-top: 22rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  min-height: 72rpx;
  padding: 0 26rpx;
  margin: 0 16rpx 16rpx 0;
  background: #EAF7FE;
  color: var(--c-primary-deep);
  border: 2rpx solid #CDEAF9;
  border-radius: var(--r-pill);
  font-size: 30rpx;
  font-weight: 600;
}

.chip-emoji {
  margin-right: 8rpx;
  font-size: 30rpx;
}

/* ---------- 按钮与提示 ---------- */
.btn-block {
  width: 100%;
  margin-top: 12rpx;
}

.ask-warn {
  margin: 6rpx 0 16rpx;
  color: var(--c-orange);
}

/* 统一的轻点反馈：缩一点点，不刺眼 */
.hover-soft {
  transform: scale(0.97);
  opacity: 0.92;
}
