/* 错题本页面专属样式：颜色只用 app.wxss 的 CSS 变量，答错一律暖橙 */

.center-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.guest-text {
  margin: 20rpx 0 32rpx;
}

.guest-btn {
  width: 100%;
}

/* ---------- 统计卡 ---------- */
.stat-card {
  text-align: center;
}

.total-num {
  font-size: 96rpx;
  line-height: 1.1;
  color: var(--c-primary-deep);
}

.wp-box {
  margin-top: 24rpx;
  border-top: 2rpx solid var(--c-line);
  padding-top: 24rpx;
}

.pill-gap {
  margin: 12rpx 12rpx 0 0;
}

/* ---------- 只练错题 ---------- */
.practice-btn {
  width: 100%;
}

.tip-text {
  margin-top: 16rpx;
  text-align: center;
}

/* ---------- 错题清单 ---------- */
.item-head {
  min-height: 88rpx;
}

.stem-text {
  margin-bottom: 12rpx;
}

.meta-row {
  align-items: center;
}

.meta-item {
  margin: 0 12rpx 12rpx 0;
}

.detail {
  border-top: 2rpx solid var(--c-line);
  padding-top: 20rpx;
}

.review-line {
  display: flex;
  align-items: flex-start;
  margin-top: 14rpx;
}

.line-key {
  flex-shrink: 0;
  width: 150rpx;
  font-size: 28rpx;
  color: var(--c-sub);
}

.line-val {
  flex: 1;
  font-size: 32rpx;
}

.your-val {
  color: var(--c-orange);
}

.right-val {
  color: var(--c-green);
}

.analysis {
  background: var(--c-bg);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-top: 20rpx;
}

.last-at {
  margin-top: 16rpx;
}

/* ---------- 空态与清空 ---------- */
.empty-text {
  margin: 16rpx 0 28rpx;
}

.clear-btn {
  margin-bottom: 40rpx;
}

/* ---------- 改 / 删（错题本也要能维护） ---------- */
.actions-row {
  margin-top: 20rpx;
  gap: 16rpx;
}

.act-btn {
  min-height: 88rpx;
  padding: 0 32rpx;
}

.act-del {
  border-color: var(--c-orange);
  color: #C24A22;
}

.edit-box {
  margin-top: 20rpx;
  padding: 24rpx;
  background: #F7FBFF;
  border-radius: 20rpx;
}

.edit-title {
  margin-bottom: 16rpx;
}

.edit-field {
  margin-bottom: 20rpx;
}

.edit-label {
  display: block;
  font-size: 28rpx;
  color: var(--c-sub);
  margin-bottom: 10rpx;
}

.edit-input {
  width: 100%;
  min-height: 88rpx;
}

.edit-textarea {
  width: 100%;
  min-height: 140rpx;
}

/* 选项胶囊：点一下就把它设为正确答案 */
.chip-opt {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 24rpx;
  margin: 0 16rpx 16rpx 0;
  background: #FFFFFF;
  border: 3rpx solid var(--c-line);
  border-radius: var(--r-pill);
}

.chip-opt-on {
  border-color: var(--c-green);
  background: #EEF9EF;
}

.chip-opt-key {
  font-weight: 700;
  color: var(--c-primary-deep);
  margin-right: 12rpx;
  font-size: 30rpx;
}

.chip-opt-on .chip-opt-key {
  color: #2E7D32;
}

.chip-opt-text {
  font-size: 30rpx;
  color: var(--c-text);
}
