/* 我的页面专属样式：颜色只用 app.wxss 的 CSS 变量 */

/* ---------- 等级与进度 ---------- */
.lv-row {
  display: flex;
  align-items: center;
  margin: 8rpx 0 16rpx;
}

.lv-badge {
  padding: 6rpx 20rpx;
  margin-right: 16rpx;
  border-radius: var(--r-pill);
  background: var(--c-primary);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
}

.lv-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--c-text);
}

.lv-bar {
  margin-bottom: 12rpx;
}

.lv-tip {
  margin-bottom: 8rpx;
}

/* ---------- 音效开关 ---------- */
.sound-card {
  margin-bottom: 40rpx;
}

.sound-card .grow {
  padding-right: 20rpx;
}

.center-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.guest-text {
  margin: 20rpx 0 32rpx;
}

.guest-btn {
  width: 100%;
}

/* ---------- 个人概览 ---------- */
.hero {
  text-align: center;
}

.xp-box {
  margin: 20rpx 0 8rpx;
}

.xp-num {
  font-size: 96rpx;
  line-height: 1.1;
  color: var(--c-primary-deep);
}

.stat-wrap {
  margin-top: 24rpx;
  border-top: 2rpx solid var(--c-line);
  padding-top: 24rpx;
}

.stat-item {
  width: 50%;
  text-align: center;
}

.stat-num {
  font-size: 44rpx;
  color: var(--c-primary-deep);
}

.stat-text {
  font-size: 36rpx;
  font-weight: 600;
}

/* ---------- 标签胶囊 ---------- */
.pill-gap {
  margin: 12rpx 12rpx 0 0;
}

/* ---------- 历史闯关 ---------- */
.session-item {
  border-top: 2rpx solid var(--c-line);
  padding: 24rpx 0 12rpx;
  min-height: 88rpx;
}

.session-title {
  flex: 1;
  margin-right: 16rpx;
}

.session-tags {
  margin-top: 12rpx;
  align-items: center;
}

.session-tag {
  margin-right: 12rpx;
}

.go-text {
  margin-left: auto;
}

.clear-btn {
  margin-bottom: 40rpx;
}
