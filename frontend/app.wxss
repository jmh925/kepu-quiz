/* ============================================================
   全局视觉基调（面向中小学生）
   原则：圆润、明亮、大字、大按钮；答错用暖橙而不是纯红，
        避免"红色叉号"带来的挫败感与畏难情绪。
   ============================================================ */
page {
  /* 色彩 */
  --c-primary: #4FC3F7;
  --c-primary-deep: #0288D1;
  --c-yellow: #FFCA28;
  --c-green: #66BB6A;
  --c-orange: #FF8A65;
  --c-purple: #9575CD;
  --c-text: #2F3E4E;
  --c-sub: #7B8A99;
  --c-line: #E3EEF7;
  --c-bg: #F7FBFF;
  --c-card: #FFFFFF;

  /* 形状 */
  --r-card: 24rpx;
  --r-pill: 999rpx;
  --shadow: 0 8rpx 24rpx rgba(79, 195, 247, 0.16);

  background: var(--c-bg);
  color: var(--c-text);
  font-size: 32rpx;
  line-height: 1.7;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}

/* ---------- 布局 ---------- */
.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 40rpx;
  box-sizing: border-box;
}

.row {
  display: flex;
  align-items: center;
}

.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.wrap {
  display: flex;
  flex-wrap: wrap;
}

.grow {
  flex: 1;
}

/* ---------- 文字层级（字号比成人产品大约 2-4pt） ---------- */
.h1 {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.4;
}

.h2 {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.4;
}

.h3 {
  font-size: 34rpx;
  font-weight: 600;
}

.body {
  font-size: 32rpx;
}

.muted {
  font-size: 28rpx;
  color: var(--c-sub);
}

.mono-num {
  font-family: "DIN Alternate", "Times New Roman", serif;
  font-weight: 700;
}

/* ---------- 卡片 ---------- */
.card {
  background: var(--c-card);
  border-radius: var(--r-card);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
}

.card-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

/* ---------- 按钮（点按区域 ≥ 96rpx，儿童手指友好） ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  padding: 0 40rpx;
  border-radius: var(--r-pill);
  font-size: 34rpx;
  font-weight: 600;
  border: none;
  line-height: 1.2;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: var(--c-primary);
  color: #FFFFFF;
  box-shadow: 0 8rpx 20rpx rgba(79, 195, 247, 0.35);
}

.btn-primary.disabled,
.btn-primary[disabled] {
  background: #C9E6F5;
  color: #FFFFFF;
  box-shadow: none;
}

.btn-ghost {
  background: #FFFFFF;
  color: var(--c-primary-deep);
  border: 2rpx solid var(--c-primary);
}

.btn-warm {
  background: var(--c-orange);
  color: #FFFFFF;
  box-shadow: 0 8rpx 20rpx rgba(255, 138, 101, 0.32);
}

.btn-sm {
  min-height: 72rpx;
  font-size: 30rpx;
  padding: 0 28rpx;
}

/* ---------- 标签 / 胶囊 ---------- */
.pill {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 24rpx;
  border-radius: var(--r-pill);
  font-size: 28rpx;
  background: #EAF7FE;
  color: var(--c-primary-deep);
}

.pill-yellow {
  background: #FFF6DC;
  color: #9A6B00;
}

.pill-green {
  background: #E8F6E9;
  color: #2E7D32;
}

.pill-orange {
  background: #FFEDE6;
  color: #C24A22;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  background: #F1F7FC;
  color: var(--c-sub);
}

/* ---------- 空状态 ---------- */
.empty {
  text-align: center;
  padding: 80rpx 40rpx;
  color: var(--c-sub);
  font-size: 30rpx;
}

.divider {
  height: 2rpx;
  background: var(--c-line);
  margin: 20rpx 0;
}

/* ---------- 文本输入 ---------- */
.input {
  background: #FFFFFF;
  border: 2rpx solid var(--c-line);
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 34rpx;
  min-height: 96rpx;
  box-sizing: border-box;
}

/* ---------- 选项（答题页用） ---------- */
.option {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  background: #FFFFFF;
  border: 3rpx solid var(--c-line);
  border-radius: 22rpx;
  font-size: 34rpx;
  box-sizing: border-box;
}

.option-key {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #EAF7FE;
  color: var(--c-primary-deep);
  font-weight: 700;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

/* 选中但未判分 */
.option.selected {
  border-color: var(--c-primary);
  background: #F2FBFF;
}

/* 判分后：正确用绿色，错误用暖橙（不用纯红） */
.option.correct {
  border-color: var(--c-green);
  background: #EEF9EF;
}

.option.correct .option-key {
  background: var(--c-green);
  color: #FFFFFF;
}

.option.wrong {
  border-color: var(--c-orange);
  background: #FFF3EE;
}

.option.wrong .option-key {
  background: var(--c-orange);
  color: #FFFFFF;
}

.option.disabled {
  opacity: 0.92;
}

/* ---------- 进度条 ---------- */
.progress {
  height: 20rpx;
  background: #E7F3FA;
  border-radius: var(--r-pill);
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  background: linear-gradient(90deg, #4FC3F7, #66BB6A);
  border-radius: var(--r-pill);
  transition: width 0.3s ease;
}
