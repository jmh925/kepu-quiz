# 仓库运行产物与本地配置
.venv/
.wheels/
.buildtmp/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# 运行期数据库（首次启动自动创建，含测试数据，不入库）
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db-wal

# 本地环境配置（含密钥，禁止提交）
backend/.env

# 打包产物（tools/package_release.py 的输出）。
# 必须忽略：交付包里带着 backend/.env（管理员口令）和 data/kepu.db（全部运行数据），
# 一旦误提交就会把口令推到公开仓库。
dist/

# 编辑器与系统文件
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# 临时排查产物
backend/_diag_*.py
backend/tests/_*.log
