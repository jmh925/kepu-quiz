# 复制本文件为 .env 并按需修改；不配置也能直接运行（全部有默认值）
# ---------- 服务 ----------
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=*

# ---------- 数据库 ----------
DB_PATH=data/kepu.db

# ---------- 大模型（留空则自动降级内置题库，答辩演示不依赖网络与付费额度） ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=120

# ---------- 鉴权 ----------
JWT_SECRET=please-change-this-in-production
JWT_EXPIRE_DAYS=7

# ---------- 管理端 ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=kepu@2026
ADMIN_TOKEN=kepu-admin-token-dev
ADMIN_MAX_FAIL=5
ADMIN_LOCK_SECONDS=60

# ---------- 检索增强与上传 ----------
RAG_TOP_K=3
RAG_CONTEXT_MAX=2000
MAX_UPLOAD_BYTES=2097152
